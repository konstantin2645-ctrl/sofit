# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sofit

# Secret for signing admin sessions (min 32 chars). Generate: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# First administrator (created by `npm run db:seed` if it does not exist)
ADMIN_EMAIL=admin@sofit.live
ADMIN_PASSWORD=sofit-admin-2026

# Public site URL (used for SEO: canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where uploaded files are stored on disk
UPLOAD_DIR=./storage/uploads
